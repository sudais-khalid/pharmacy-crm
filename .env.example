# --- Local development (npm run dev) ---
# PostgreSQL connection string
DATABASE_URL="postgresql://pharmacy:change_me@localhost:5432/pharmacy_crm?schema=public"

# Optional, recommended in production: a dedicated login that is a member of the pcrm_app role, e.g.
#   CREATE ROLE pharmacy_app LOGIN PASSWORD '...' IN ROLE pcrm_app;
# Without it the app uses DATABASE_URL and switches to pcrm_app at connection start.
APP_DATABASE_URL=""

# Long random string used to sign login sessions. Generate one with:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# --- Developer (platform owner) account ---
# Creates the Developer account on the very first start only; ignored once it exists.
# Use PLATFORM_OWNER_PASSWORD_HASH (bcrypt) instead of the plain password for builds that bake it in.
PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_PASSWORD=""
# Encrypts two-factor secrets at rest (32+ random characters). Falls back to JWT_SECRET when empty.
TOTP_ENCRYPTION_KEY=""

# Timezone used for "today", daily reports and the sales chart
APP_TIMEZONE="Asia/Karachi"

# --- Docker Compose only ---
# Password for the bundled PostgreSQL container (compose builds DATABASE_URL from it)
POSTGRES_PASSWORD="change_me"

# --- Security ---
# 1 only when a reverse proxy (e.g. Caddy) in front of the app sets X-Forwarded-For; otherwise leave 0
TRUST_PROXY="0"
# 0 only for plain http on a local network (the desktop app sets it); keep it unset behind HTTPS
SESSION_COOKIE_SECURE=""
# Extra origins allowed to send write requests (comma separated), e.g. a LAN address
ALLOWED_ORIGINS=""
