{
  "name": "pharmacy-crm",
  "version": "2.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "build:desktop": "node scripts/build-standalone.mjs",
    "start": "next start",
    "worker": "node dist/worker.js",
    "ops": "node dist/ops.js",
    "e2e": "node scripts/e2e-local.mjs",
    "perf": "node scripts/perf-check.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "lint": "next lint",
    "lint:deps": "depcruise src tests prisma --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:check": "node scripts/db-check.mjs",
    "postinstall": "prisma generate",
    "test:smoke": "bash scripts/smoke.sh",
    "platform:recover-owner": "tsx scripts/recover-owner.ts",
    "test:isolation": "node scripts/isolation-check.mjs",
    "db:check:local": "node scripts/db-check-local.mjs",
    "bench:search": "tsx scripts/bench-search.ts",
    "ocr:accuracy": "node scripts/ocr-accuracy.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@tesseract.js-data/eng": "1.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "jose": "^5.9.6",
    "jpeg-js": "^0.4.4",
    "jszip": "3.10.2",
    "lucide-react": "^0.454.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.14.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "read-excel-file": "9.3.10",
    "recharts": "^2.13.3",
    "tesseract.js": "7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^18.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "$postcss",
    "effect": "^3.22.2",
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
