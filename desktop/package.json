{
  "name": "pharmacy-crm-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Windows desktop app: Electron supervisor with embedded PostgreSQL, the web server and the worker",
  "main": "src/main.mjs",
  "scripts": {
    "start": "node scripts/run-electron.mjs",
    "selftest": "node scripts/selftest.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "owner": "node scripts/owner.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "16.14.0-beta.17",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true
  },
  "productName": "Pharmacy CRM",
  "author": "Sudais Khalid"
}
