generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  SALE_CANCEL
  ADJUSTMENT
  DAMAGE
  EXPIRY
}

enum LedgerKind {
  INVOICE
  PAYMENT
  ADJUSTMENT
  CANCELLATION
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales           Sale[]
  purchases       Purchase[]
  stockMovements  StockMovement[]
  customerLedgers CustomerLedger[]
  supplierLedgers SupplierLedger[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  medicines Medicine[]
}

model Medicine {
  id                   String   @id @default(uuid())
  name                 String
  genericName          String?
  categoryId           String?
  barcode              String?  @unique
  sku                  String?  @unique
  unit                 String   @default("Pack")
  purchasePrice        Decimal  @default(0) @db.Decimal(12, 2)
  salePrice            Decimal  @default(0) @db.Decimal(12, 2)
  minStock             Int      @default(10)
  prescriptionRequired Boolean  @default(false)
  description          String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category      Category?       @relation(fields: [categoryId], references: [id])
  batches       Batch[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@index([name])
  @@index([genericName])
  @@index([categoryId])
}

// Stock is held per batch. A medicine's stock is the sum of its non-expired batches.
model Batch {
  id            String   @id @default(uuid())
  medicineId    String
  batchNumber   String
  expiryDate    DateTime @db.Date
  quantity      Int      @default(0)
  purchasePrice Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicine      Medicine        @relation(fields: [medicineId], references: [id])
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([expiryDate])
}

// Every change to a batch quantity writes one row here. quantity is signed.
model StockMovement {
  id           String       @id @default(uuid())
  medicineId   String
  batchId      String
  type         MovementType
  quantity     Int
  balanceAfter Int
  reference    String?
  note         String?
  userId       String?
  createdAt    DateTime     @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([medicineId, createdAt])
  @@index([batchId])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales  Sale[]
  ledger CustomerLedger[]

  @@index([name])
  @@index([phone])
}

// balance owed by customer = SUM(debit) - SUM(credit)
model CustomerLedger {
  id          String         @id @default(uuid())
  customerId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  saleId      String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId, createdAt])
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
  ledger    SupplierLedger[]

  @@index([name])
}

// payable to supplier = SUM(debit) - SUM(credit)   (debit = purchase invoice, credit = payment)
model SupplierLedger {
  id          String         @id @default(uuid())
  supplierId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  purchaseId  String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([supplierId, createdAt])
}

model Purchase {
  id              String         @id @default(uuid())
  number          String         @unique
  supplierInvoice String?
  supplierId      String
  userId          String
  purchaseDate    DateTime       @db.Date
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paid            Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  note            String?
  createdAt       DateTime       @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  ledger   SupplierLedger[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  medicineId    String
  batchId       String
  batchNumber   String
  expiryDate    DateTime @db.Date
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([purchaseId])
  @@index([medicineId])
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNo     String        @unique
  customerId    String?
  userId        String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now())
  cancelledAt   DateTime?
  cancelReason  String?

  customer Customer?        @relation(fields: [customerId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    SaleItem[]
  ledger   CustomerLedger[]

  @@index([createdAt])
  @@index([customerId])
  @@index([userId])
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String
  medicineId String
  batchId    String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  costPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([medicineId])
}

model Setting {
  id                Int      @id @default(1)
  pharmacyName      String   @default("My Pharmacy")
  address           String   @default("")
  phone             String   @default("")
  email             String   @default("")
  invoiceFooter     String   @default("Thank you for your purchase. Get well soon!")
  expiryWarningDays Int      @default(90)
  currency          String   @default("PKR")
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Platform foundation (Phase 0). pharmacyId and realm columns arrive with tenancy in Phase 1.
// ---------------------------------------------------------------------------

// Append-only record of every state change. A trigger blocks UPDATE and DELETE.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  actorId   String?
  action    String // e.g. sale.create, sale.cancel, medicine.price.update
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?

  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([at])
}

// Transactional outbox: written in the same transaction as the change, dispatched by the worker.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now()) // next attempt time (backoff after failures)
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, availableAt, id])
}

// Stored responses for retried writes. Kept for 24 hours.
model IdempotencyKey {
  actorId     String
  key         String
  route       String
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now())

  @@id([actorId, key])
  @@index([createdAt])
}

// Sliding-window rate limiting shared by all server processes.
model RateLimitHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  at     DateTime @default(now())

  @@index([bucket, at])
}
