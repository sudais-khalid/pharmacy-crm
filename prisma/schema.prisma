generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  SALE_CANCEL
  ADJUSTMENT
  DAMAGE
  EXPIRY
}

enum LedgerKind {
  INVOICE
  PAYMENT
  ADJUSTMENT
  CANCELLATION
}

model User {
  id                 String    @id @default(uuid())
  pharmacyId         String    @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name               String
  email              String    @unique
  username           String
  passwordHash       String
  role               Role      @default(CASHIER)
  active             Boolean   @default(true)
  isSystem           Boolean   @default(false) // hidden account used for platform support sessions
  sessionVersion     Int       @default(1)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sales           Sale[]
  purchases       Purchase[]
  stockMovements  StockMovement[]
  customerLedgers CustomerLedger[]
  supplierLedgers SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, username])
  @@index([pharmacyId])
}

model Category {
  id         String     @id @default(uuid())
  pharmacyId String     @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name       String
  createdAt  DateTime   @default(now())
  medicines  Medicine[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, name])
}

model Medicine {
  id                   String   @id @default(uuid())
  pharmacyId           String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name                 String
  genericName          String?
  categoryId           String?
  barcode              String?
  sku                  String?
  unit                 String   @default("Pack")
  purchasePrice        Decimal  @default(0) @db.Decimal(12, 2)
  salePrice            Decimal  @default(0) @db.Decimal(12, 2)
  minStock             Int      @default(10)
  prescriptionRequired Boolean  @default(false)
  description          String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category      Category?       @relation(fields: [categoryId], references: [id])
  batches       Batch[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, barcode])
  @@unique([pharmacyId, sku])
  @@index([pharmacyId, name])
  @@index([genericName])
  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_name_trgm_idx")
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_genericName_trgm_idx")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_barcode_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_sku_trgm_idx")
}

// Stock is held per batch. A medicine's stock is the sum of its non-expired batches.
model Batch {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  medicineId    String
  batchNumber   String
  expiryDate    DateTime @db.Date
  quantity      Int      @default(0)
  purchasePrice Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicine      Medicine        @relation(fields: [medicineId], references: [id])
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([pharmacyId, expiryDate])
  @@index([batchNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Batch_batchNumber_trgm_idx")
}

// Every change to a batch quantity writes one row here. quantity is signed.
model StockMovement {
  id           String       @id @default(uuid())
  pharmacyId   String       @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  medicineId   String
  batchId      String
  type         MovementType
  quantity     Int
  balanceAfter Int
  reference    String?
  note         String?
  userId       String?
  createdAt    DateTime     @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([medicineId, createdAt])
  @@index([batchId])
  @@index([pharmacyId, createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  pharmacyId  String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name        String
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales  Sale[]
  ledger CustomerLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, name])
  @@index([phone])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm_idx")
}

// balance owed by customer = SUM(debit) - SUM(credit)
model CustomerLedger {
  id          String         @id @default(uuid())
  pharmacyId  String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  customerId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  saleId      String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([customerId, createdAt])
  @@index([pharmacyId])
}

model Supplier {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
  ledger    SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Supplier_name_trgm_idx")
}

// payable to supplier = SUM(debit) - SUM(credit)   (debit = purchase invoice, credit = payment)
model SupplierLedger {
  id          String         @id @default(uuid())
  pharmacyId  String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  supplierId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  purchaseId  String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([supplierId, createdAt])
  @@index([pharmacyId])
}

model Purchase {
  id              String         @id @default(uuid())
  pharmacyId      String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number          String
  supplierInvoice String?
  supplierId      String
  userId          String
  purchaseDate    DateTime       @db.Date
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  paid            Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  note            String?
  createdAt       DateTime       @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  ledger   SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, number])
  @@index([supplierId])
  @@index([pharmacyId, purchaseDate])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  purchaseId    String
  medicineId    String
  batchId       String
  batchNumber   String
  expiryDate    DateTime @db.Date
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  salePrice     Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([purchaseId])
  @@index([medicineId])
  @@index([pharmacyId])
}

model Sale {
  id            String        @id @default(uuid())
  pharmacyId    String        @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  invoiceNo     String
  customerId    String?
  userId        String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  note          String?
  createdAt     DateTime      @default(now())
  cancelledAt   DateTime?
  cancelReason  String?

  customer Customer?        @relation(fields: [customerId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    SaleItem[]
  ledger   CustomerLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, invoiceNo])
  @@index([pharmacyId, createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([invoiceNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Sale_invoiceNo_trgm_idx")
}

model SaleItem {
  id         String  @id @default(uuid())
  pharmacyId String  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  saleId     String
  medicineId String
  batchId    String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  costPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([saleId])
  @@index([medicineId])
  @@index([pharmacyId])
}

// ---------------------------------------------------------------------------
// Platform foundation (Phase 0). pharmacyId and realm columns arrive with tenancy in Phase 1.
// ---------------------------------------------------------------------------

// Append-only record of every state change. A trigger blocks UPDATE and DELETE.
model AuditLog {
  id               BigInt   @id @default(autoincrement())
  pharmacyId       String?  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  at               DateTime @default(now())
  realm            Realm    @default(STAFF)
  actorId          String?
  supportSessionId String? // set while the Developer works inside a pharmacy
  action           String // e.g. sale.create, sale.cancel, medicine.price.update
  entity           String
  entityId         String
  before           Json?
  after            Json?
  ip               String?
  userAgent        String?

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([pharmacyId, at])
}

// Transactional outbox: written in the same transaction as the change, dispatched by the worker.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  pharmacyId  String?   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now()) // next attempt time (backoff after failures)
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([processedAt, availableAt, id])
  @@index([pharmacyId])
}

// Stored responses for retried writes. Kept for 24 hours.
model IdempotencyKey {
  actorId     String
  key         String
  route       String
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now())

  @@id([actorId, key])
  @@index([createdAt])
}

// Sliding-window rate limiting shared by all server processes.
model RateLimitHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  at     DateTime @default(now())

  @@index([bucket, at])
}

// ---------------------------------------------------------------------------
// Tenancy and platform (Phase 1). docs/plan/03-data-model.md, section 2.
// ---------------------------------------------------------------------------

enum PharmacyStatus {
  ACTIVE
  GRACE
  SUSPENDED
  DEACTIVATED
}

enum Realm {
  PLATFORM
  STAFF
}

enum TokenPurpose {
  INVITE
  RESET
}

// A pharmacy is one tenant. Only the platform console writes status, plan, limits and slug.
model Pharmacy {
  id                 String         @id @default(uuid())
  slug               String         @unique
  name               String
  legalName          String?
  address            String         @default("")
  city               String?
  phone              String         @default("")
  whatsapp           String?
  email              String?
  licenseNumber      String?
  taxNumber          String?
  status             PharmacyStatus @default(ACTIVE)
  statusReason       String?
  plan               String         @default("STANDARD")
  subscriptionEndsAt DateTime?
  maxUsers           Int            @default(10)
  ocrMonthlyLimit    Int            @default(300)
  timezone           String         @default("Asia/Karachi")
  currency           String         @default("PKR")
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  settings        PharmacySettings?
  counters        TenantCounter[]
  featureFlags    FeatureFlag[]
  supportSessions SupportSession[]
  authTokens      AuthToken[]
  users           User[]
  categories      Category[]
  medicines       Medicine[]
  batches         Batch[]
  stockMovements  StockMovement[]
  customers       Customer[]
  customerLedgers CustomerLedger[]
  suppliers       Supplier[]
  supplierLedgers SupplierLedger[]
  purchases       Purchase[]
  purchaseItems   PurchaseItem[]
  sales           Sale[]
  saleItems       SaleItem[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]

  @@index([status])
}

// Operational settings, one row per pharmacy.
model PharmacySettings {
  pharmacyId        String   @id
  invoiceFooter     String   @default("Thank you for your purchase. Get well soon!")
  expiryWarningDays Int      @default(90)
  expiryAlertDays   Int      @default(30)
  updatedAt         DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
}

// Developer accounts. No API writes this table except an owner changing their own password and 2FA.
model PlatformUser {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  totpSecret     String? // AES-256-GCM encrypted
  totpEnabledAt  DateTime?
  totpLastStep   BigInt? // last accepted time step, so a code cannot be replayed
  recoveryCodes  String[] // SHA-256 hashes
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Per-pharmacy number series (invoices, purchases, ...). Replaces global sequences.
model TenantCounter {
  pharmacyId String
  key        String
  value      BigInt @default(0)

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, key])
}

// Invite and password reset links. Only the SHA-256 of the token is stored.
model AuthToken {
  id             String       @id @default(uuid())
  realm          Realm
  subjectId      String
  pharmacyId     String?
  purpose        TokenPurpose
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdByRealm Realm
  createdById    String
  createdAt      DateTime     @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([subjectId, purpose])
}

// The Developer working inside a pharmacy. Every audit row written meanwhile references it.
model SupportSession {
  id             String    @id @default(uuid())
  platformUserId String
  pharmacyId     String
  reason         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, startedAt])
}

// Per-pharmacy feature switches set by the Developer. Defaults live in code.
model FeatureFlag {
  pharmacyId String
  key        String
  enabled    Boolean
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, key])
}
