generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  SALE_CANCEL
  ADJUSTMENT
  DAMAGE
  EXPIRY
  SALE_RETURN
  SUPPLIER_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

enum LedgerKind {
  INVOICE
  PAYMENT
  ADJUSTMENT
  CANCELLATION
  RETURN
}

model User {
  id                 String    @id @default(uuid())
  pharmacyId         String    @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name               String
  email              String
  username           String
  passwordHash       String
  roleId             String
  active             Boolean   @default(true)
  isSystem           Boolean   @default(false) // hidden account used for platform support sessions
  sessionVersion     Int       @default(1)
  mustChangePassword Boolean   @default(false)
  totpSecret         String? // sealed (secret-box); set while enrolling, kept once confirmed
  totpEnabledAt      DateTime?
  totpLastStep       BigInt? // each code works once
  recoveryCodes      String[]  @default([]) // sha256 of the one-time recovery codes
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sales           Sale[]
  purchases       Purchase[]
  stockMovements  StockMovement[]
  cashSessions    CashSession[]    @relation("CashSessionUser")
  closedSessions  CashSession[]    @relation("CashSessionCloser")
  cashMovements   CashMovement[]
  saleReturns     SaleReturn[]
  ordersCreated   PurchaseOrder[]  @relation("OrderCreatedBy")
  expenses        Expense[]
  ordersApproved  PurchaseOrder[]  @relation("OrderApprovedBy")
  supplierReturns SupplierReturn[]
  customerLedgers CustomerLedger[]
  supplierLedgers SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([pharmacyId, username])
  @@unique([pharmacyId, email])
  @@index([pharmacyId])
  @@index([roleId])
}

// A role: one of the shared templates (pharmacyId null, read-only, permissions from code) or a custom role
// of one pharmacy. See src/modules/identity/permissions.ts for the catalog.
model Role {
  id          String   @id @default(uuid())
  pharmacyId  String?  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  key         String
  name        String
  description String?
  system      Boolean  @default(false)
  permissions String[] @default([])
  landingPath String   @default("/dashboard")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  // Restrict, not the optional-relation default (set null), which would turn custom roles into templates
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)

  @@unique([pharmacyId, key])
  @@index([pharmacyId])
}

model Category {
  id         String     @id @default(uuid())
  pharmacyId String     @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name       String
  createdAt  DateTime   @default(now())
  medicines  Medicine[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, name])
}

model Medicine {
  id                   String   @id @default(uuid())
  pharmacyId           String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name                 String
  genericName          String?
  categoryId           String?
  barcode              String?
  sku                  String?
  unit                 String   @default("Pack")
  purchasePrice        Decimal  @default(0) @db.Decimal(12, 2)
  salePrice            Decimal  @default(0) @db.Decimal(12, 2)
  minStock             Int      @default(10)
  prescriptionRequired Boolean  @default(false)
  description          String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category            Category?            @relation(fields: [categoryId], references: [id])
  batches             Batch[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  intakeLines         StockIntakeLine[]
  aliases             SupplierItemAlias[]
  movements           StockMovement[]
  supplierProducts    SupplierProduct[]
  orderItems          PurchaseOrderItem[]
  supplierReturnItems SupplierReturnItem[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, barcode])
  @@unique([pharmacyId, sku])
  @@index([pharmacyId, name])
  @@index([genericName])
  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_name_trgm_idx")
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_genericName_trgm_idx")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_barcode_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_sku_trgm_idx")
}

// Stock is held per batch. A medicine's stock is the sum of its non-expired batches.
model Batch {
  id            String    @id @default(uuid())
  pharmacyId    String    @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  medicineId    String
  batchNumber   String
  expiryDate    DateTime  @db.Date
  quantity      Int       @default(0)
  purchasePrice Decimal   @db.Decimal(12, 4)
  salePrice     Decimal   @db.Decimal(12, 2)
  setAsideAt    DateTime? // marked for return to the supplier (expired or near expiry); not sold meanwhile
  setAsideNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  medicine            Medicine             @relation(fields: [medicineId], references: [id])
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  movements           StockMovement[]
  returnItems         SaleReturnItem[]
  supplierReturnItems SupplierReturnItem[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([pharmacyId, expiryDate])
  @@index([batchNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Batch_batchNumber_trgm_idx")
}

// Every change to a batch quantity writes one row here. quantity is signed.
model StockMovement {
  id           String       @id @default(uuid())
  pharmacyId   String       @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  medicineId   String
  batchId      String
  type         MovementType
  quantity     Int
  balanceAfter Int
  reference    String?
  note         String?
  userId       String?
  createdAt    DateTime     @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([medicineId, createdAt])
  @@index([batchId])
  @@index([pharmacyId, createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  pharmacyId  String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name        String
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales  Sale[]
  ledger CustomerLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, name])
  @@index([phone])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_phone_trgm_idx")
}

// balance owed by customer = SUM(debit) - SUM(credit)
model CustomerLedger {
  id          String         @id @default(uuid())
  pharmacyId  String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  customerId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  saleId      String?
  returnId    String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  saleReturn SaleReturn? @relation(fields: [returnId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([customerId, createdAt])
  @@index([pharmacyId])
}

model Supplier {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
  ledger    SupplierLedger[]
  intakes   StockIntake[]
  catalog   SupplierProduct[]
  orders    PurchaseOrder[]
  returns   SupplierReturn[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Supplier_name_trgm_idx")
}

// payable to supplier = SUM(debit) - SUM(credit)   (debit = purchase invoice, credit = payment)
model SupplierLedger {
  id          String         @id @default(uuid())
  pharmacyId  String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  supplierId  String
  kind        LedgerKind
  debit       Decimal        @default(0) @db.Decimal(12, 2)
  credit      Decimal        @default(0) @db.Decimal(12, 2)
  description String
  purchaseId  String?
  method      PaymentMethod?
  userId      String?
  createdAt   DateTime       @default(now())

  supplierReturnId String?

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id])
  supplierReturn SupplierReturn? @relation(fields: [supplierReturnId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([supplierId, createdAt])
  @@index([pharmacyId])
}

model Purchase {
  id              String         @id @default(uuid())
  pharmacyId      String         @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number          String
  supplierInvoice String?
  supplierId      String
  userId          String
  purchaseDate    DateTime       @db.Date
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  intakeId        String?        @unique // the stock entry it was posted from
  purchaseOrderId String? // the order it fulfils
  paid            Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  note            String?
  createdAt       DateTime       @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
  ledger   SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  intake StockIntake?   @relation(fields: [intakeId], references: [id])
  order  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@unique([pharmacyId, number])
  @@unique([pharmacyId, supplierId, supplierInvoice]) // the same bill cannot be entered twice
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([pharmacyId, purchaseDate])
}

model PurchaseItem {
  id              String   @id @default(uuid())
  pharmacyId      String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  purchaseId      String
  medicineId      String
  batchId         String
  batchNumber     String
  expiryDate      DateTime @db.Date
  quantity        Int
  bonusQty        Int      @default(0) // free units, added to stock
  purchasePrice   Decimal  @db.Decimal(12, 2) // rate on the bill
  discountPercent Decimal  @default(0) @db.Decimal(5, 2) // trade discount
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  effectiveCost   Decimal  @db.Decimal(12, 4) // lineTotal / (quantity + bonusQty): the batch cost for profit
  salePrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([purchaseId])
  @@index([medicineId])
  @@index([pharmacyId])
}

model Sale {
  id            String        @id @default(uuid())
  pharmacyId    String        @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  invoiceNo     String
  customerId    String?
  userId        String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  note          String?
  customerName  String? // walk-in name printed on the bill
  customerPhone String? // walk-in contact printed on the bill
  cashSessionId String?
  cashTendered  Decimal?      @db.Decimal(12, 2)
  changeGiven   Decimal       @default(0) @db.Decimal(12, 2)
  receiptFormat String? // format at print time, so a reprint looks the same
  createdAt     DateTime      @default(now())
  cancelledAt   DateTime?
  cancelReason  String?

  customer    Customer?        @relation(fields: [customerId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  cashSession CashSession?     @relation(fields: [cashSessionId], references: [id])
  items       SaleItem[]
  ledger      CustomerLedger[]
  returns     SaleReturn[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, invoiceNo])
  @@index([pharmacyId, createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([cashSessionId])
  @@index([pharmacyId, customerPhone])
  @@index([invoiceNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Sale_invoiceNo_trgm_idx")
}

model SaleItem {
  id         String  @id @default(uuid())
  pharmacyId String  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  saleId     String
  medicineId String
  batchId    String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  costPrice  Decimal @db.Decimal(12, 4)
  lineTotal  Decimal @db.Decimal(12, 2)

  sale     Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine         @relation(fields: [medicineId], references: [id])
  batch    Batch            @relation(fields: [batchId], references: [id])
  returns  SaleReturnItem[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([saleId])
  @@index([medicineId])
  @@index([pharmacyId])
}

// A supplier's medicine list as the pharmacy buys it (data model, section 4.1). lastPrice follows each posted purchase.
model SupplierProduct {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  supplierId    String
  medicineId    String
  supplierCode  String? // the supplier's own item code, printed on its bills
  packSize      String?
  lastPrice     Decimal? @db.Decimal(12, 2)
  lastBonusRule String? // e.g. "10+1"
  leadTimeDays  Int      @default(2)
  preferred     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  medicine Medicine @relation(fields: [medicineId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, supplierId, medicineId])
  @@index([medicineId])
}

// An order to a supplier (data model, section 4.2). It never moves stock or the ledger; receiving does.
model PurchaseOrder {
  id             String              @id @default(uuid())
  pharmacyId     String              @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number         String // PO-YYYYMMDD-00001
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  source         String              @default("MANUAL") // MANUAL or SUGGESTED
  expectedDate   DateTime?           @db.Date
  note           String?
  estimatedTotal Decimal             @default(0) @db.Decimal(12, 2)
  createdById    String
  approvedById   String?
  sentAt         DateTime?
  closedAt       DateTime?
  closeReason    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdBy  User                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  approvedBy User?               @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  items      PurchaseOrderItem[]
  purchases  Purchase[]
  intakes    StockIntake[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, number])
  @@index([supplierId, status])
  @@index([pharmacyId, status, createdAt])
}

model PurchaseOrderItem {
  id            String   @id @default(uuid())
  pharmacyId    String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  orderId       String
  medicineId    String
  orderedQty    Int
  receivedQty   Int      @default(0) // paid units received; bonus units do not count against the order
  expectedPrice Decimal? @db.Decimal(12, 2)

  order    PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine      @relation(fields: [medicineId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([orderId, medicineId])
}

// Stock sent back to a supplier (data model, section 4.4): out of the batch, credited to the supplier.
model SupplierReturn {
  id         String   @id @default(uuid())
  pharmacyId String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number     String // RTS-YYYYMMDD-00001
  supplierId String
  userId     String
  total      Decimal  @db.Decimal(12, 2)
  reason     String
  createdAt  DateTime @default(now())

  supplier Supplier             @relation(fields: [supplierId], references: [id])
  user     User                 @relation(fields: [userId], references: [id])
  items    SupplierReturnItem[]
  ledger   SupplierLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, number])
  @@index([supplierId])
}

model SupplierReturnItem {
  id         String  @id @default(uuid())
  pharmacyId String  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  returnId   String
  batchId    String
  medicineId String
  quantity   Int
  unitCost   Decimal @db.Decimal(12, 4)
  lineTotal  Decimal @db.Decimal(12, 2)

  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id])
  medicine       Medicine       @relation(fields: [medicineId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([returnId])
}

// Running costs (data model, section 5): rent, salaries, bills. Never deleted; a mistake is cancelled.
model ExpenseCategory {
  id         String   @id @default(uuid())
  pharmacyId String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  expenses Expense[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, name])
}

model Expense {
  id            String        @id @default(uuid())
  pharmacyId    String        @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number        String // EXP-YYYYMMDD-00001
  categoryId    String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @db.Date
  method        PaymentMethod // CASH or CARD (a bank transfer counts as CARD)
  description   String
  receiptFileId String?
  cashSessionId String? // paid from a cashier's drawer
  userId        String
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime      @default(now())

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  cashSession CashSession?    @relation(fields: [cashSessionId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, number])
  @@index([pharmacyId, date])
}

// One row per pharmacy and local day, kept by the report.rollup job and rebuildable from the source tables
// (data model, section 5). Dashboards read it; the profit and loss report reads the source tables.
model DailySummary {
  pharmacyId   String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  date         DateTime @db.Date
  grossSales   Decimal  @default(0) @db.Decimal(14, 2) // before invoice discounts
  discounts    Decimal  @default(0) @db.Decimal(14, 2)
  returns      Decimal  @default(0) @db.Decimal(14, 2) // refunds on customer returns
  netSales     Decimal  @default(0) @db.Decimal(14, 2) // gross - discounts - returns
  cogs         Decimal  @default(0) @db.Decimal(14, 2) // cost of what was sold, less what came back to stock
  stockLosses  Decimal  @default(0) @db.Decimal(14, 2) // damage and expiry write-offs at cost
  expenses     Decimal  @default(0) @db.Decimal(14, 2)
  purchases    Decimal  @default(0) @db.Decimal(14, 2)
  invoiceCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@id([pharmacyId, date])
}

// A cashier's drawer from opening float to counted cash (data model, section 3.2). One open session per user.
model CashSession {
  id           String            @id @default(uuid())
  pharmacyId   String            @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  userId       String
  status       CashSessionStatus @default(OPEN)
  openedAt     DateTime          @default(now())
  openingFloat Decimal           @db.Decimal(12, 2)
  closedAt     DateTime?
  expectedCash Decimal?          @db.Decimal(12, 2) // computed at close
  countedCash  Decimal?          @db.Decimal(12, 2)
  difference   Decimal?          @db.Decimal(12, 2) // counted minus expected
  note         String?
  closedById   String?

  user      User           @relation("CashSessionUser", fields: [userId], references: [id])
  closedBy  User?          @relation("CashSessionCloser", fields: [closedById], references: [id])
  sales     Sale[]
  movements CashMovement[]
  expenses  Expense[]
  returns   SaleReturn[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, openedAt])
  @@index([userId, status])
}

// Cash put into or taken out of the drawer during a session (petty cash, change from the bank).
model CashMovement {
  id         String           @id @default(uuid())
  pharmacyId String           @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  sessionId  String
  type       CashMovementType
  amount     Decimal          @db.Decimal(12, 2)
  reason     String
  userId     String
  createdAt  DateTime         @default(now())

  session CashSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([sessionId])
}

// Items a customer brings back (data model, section 3.3). Lines point at the exact sale line, so batch and price are known.
model SaleReturn {
  id            String        @id @default(uuid())
  pharmacyId    String        @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number        String // RET-YYYYMMDD-00001
  saleId        String
  userId        String
  refundMethod  PaymentMethod // CASH, CARD, or CREDIT (a credit note on the customer's account)
  total         Decimal       @db.Decimal(12, 2)
  reason        String
  cashSessionId String?
  createdAt     DateTime      @default(now())

  sale        Sale             @relation(fields: [saleId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  cashSession CashSession?     @relation(fields: [cashSessionId], references: [id])
  items       SaleReturnItem[]
  ledger      CustomerLedger[]

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, number])
  @@index([saleId])
  @@index([pharmacyId, createdAt])
}

model SaleReturnItem {
  id         String  @id @default(uuid())
  pharmacyId String  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  returnId   String
  saleItemId String
  batchId    String
  medicineId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  costPrice  Decimal @db.Decimal(12, 4)
  restock    Boolean @default(true) // false: damaged, written off with a DAMAGE movement
  lineTotal  Decimal @db.Decimal(12, 2) // refund for the line, after the invoice discount

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  batch      Batch      @relation(fields: [batchId], references: [id])

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
}

// ---------------------------------------------------------------------------
// Platform foundation (Phase 0). pharmacyId and realm columns arrive with tenancy in Phase 1.
// ---------------------------------------------------------------------------

// Append-only record of every state change. A trigger blocks UPDATE and DELETE.
model AuditLog {
  id               BigInt   @id @default(autoincrement())
  pharmacyId       String?  @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  at               DateTime @default(now())
  realm            Realm    @default(STAFF)
  actorId          String?
  supportSessionId String? // set while the Developer works inside a pharmacy
  action           String // e.g. sale.create, sale.cancel, medicine.price.update
  entity           String
  entityId         String
  before           Json?
  after            Json?
  ip               String?
  userAgent        String?

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, at])
  @@index([pharmacyId, at])
}

// Transactional outbox: written in the same transaction as the change, dispatched by the worker.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  pharmacyId  String?   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now()) // next attempt time (backoff after failures)
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([processedAt, availableAt, id])
  @@index([pharmacyId])
}

// Stored responses for retried writes. Kept for 24 hours.
model IdempotencyKey {
  actorId     String
  key         String
  route       String
  requestHash String
  status      Int
  response    Json
  createdAt   DateTime @default(now())

  @@id([actorId, key])
  @@index([createdAt])
}

// Sliding-window rate limiting shared by all server processes.
model RateLimitHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  at     DateTime @default(now())

  @@index([bucket, at])
}

// ---------------------------------------------------------------------------
// Tenancy and platform (Phase 1). docs/plan/03-data-model.md, section 2.
// ---------------------------------------------------------------------------

enum IntakeKind {
  PURCHASE_BILL
  STOCK_LIST
}

enum IntakeSource {
  MANUAL
  OCR
  IMPORT
}

enum IntakeStatus {
  DRAFT
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  POSTED
  FAILED
  DISCARDED
}

enum PharmacyStatus {
  ACTIVE
  GRACE
  SUSPENDED
  DEACTIVATED
}

enum Realm {
  PLATFORM
  STAFF
}

enum TokenPurpose {
  INVITE
  RESET
}

// A pharmacy is one tenant. Only the platform console writes status, plan, limits and slug.
model Pharmacy {
  id                 String         @id @default(uuid())
  slug               String         @unique
  name               String
  legalName          String?
  address            String         @default("")
  city               String?
  phone              String         @default("")
  whatsapp           String?
  email              String?
  licenseNumber      String?
  taxNumber          String?
  brandColor         String? // hex; applied to the app, sign-in page and receipts (src/lib/brand.ts)
  logoFileId         String? // 512 px PNG
  logoIconFileId     String? // 128 px PNG for the header and small receipts
  status             PharmacyStatus @default(ACTIVE)
  statusReason       String?
  plan               String         @default("STANDARD")
  subscriptionEndsAt DateTime?
  maxUsers           Int            @default(10)
  ocrMonthlyLimit    Int            @default(300)
  ocrProviders       String[]       @default(["LOCAL"]) // OCR adapters the Developer allows (LOCAL, CLOUD)
  timezone           String         @default("Asia/Karachi")
  currency           String         @default("PKR")
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  settings            PharmacySettings?
  logo                StoredFile?          @relation("PharmacyLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  logoIcon            StoredFile?          @relation("PharmacyLogoIcon", fields: [logoIconFileId], references: [id], onDelete: SetNull)
  files               StoredFile[]         @relation("PharmacyFiles")
  notifications       Notification[]
  intakes             StockIntake[]
  intakePages         StockIntakePage[]
  intakeLines         StockIntakeLine[]
  itemAliases         SupplierItemAlias[]
  counters            TenantCounter[]
  featureFlags        FeatureFlag[]
  supportSessions     SupportSession[]
  authTokens          AuthToken[]
  users               User[]
  roles               Role[]
  categories          Category[]
  medicines           Medicine[]
  batches             Batch[]
  stockMovements      StockMovement[]
  customers           Customer[]
  customerLedgers     CustomerLedger[]
  suppliers           Supplier[]
  supplierLedgers     SupplierLedger[]
  purchases           Purchase[]
  purchaseItems       PurchaseItem[]
  sales               Sale[]
  saleItems           SaleItem[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  saleReturns         SaleReturn[]
  saleReturnItems     SaleReturnItem[]
  supplierProducts    SupplierProduct[]
  purchaseOrders      PurchaseOrder[]
  purchaseOrderItems  PurchaseOrderItem[]
  supplierReturns     SupplierReturn[]
  supplierReturnItems SupplierReturnItem[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  dailySummaries      DailySummary[]

  @@index([status])
}

// Operational settings, one row per pharmacy.
model PharmacySettings {
  pharmacyId         String   @id
  receiptHeader      String   @default("")
  requireStaffTotp   Boolean  @default(false) // every staff account needs an authenticator code to sign in
  ocrProvider        String   @default("LOCAL") // the pharmacy's choice among its allowed providers
  invoiceFooter      String   @default("Thank you for your purchase. Get well soon!")
  receiptFormat      String   @default("THERMAL_80") // THERMAL_80, THERMAL_58 or A4
  autoPrintReceipt   Boolean  @default(true)
  receiptBatchLines  Boolean  @default(false) // print batch and expiry under each receipt line
  requireCashSession Boolean  @default(true) // with cash sessions switched on: no cash sale without an open drawer
  cashDiffThreshold  Decimal  @default(100) @db.Decimal(12, 2) // a closing difference above this needs a note
  expiryWarningDays  Int      @default(90)
  expiryAlertDays    Int      @default(30)
  reorderCoverDays   Int      @default(7) // reorder suggestions keep this many days of sales beyond the lead time
  setupDoneAt        DateTime? // the Pharmacy Admin finished (or skipped) the first-run setup
  updatedAt          DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
}

// Developer accounts. No API writes this table except an owner changing their own password and 2FA.
model PlatformUser {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  totpSecret     String? // AES-256-GCM encrypted
  totpEnabledAt  DateTime?
  totpLastStep   BigInt? // last accepted time step, so a code cannot be replayed
  recoveryCodes  String[] // SHA-256 hashes
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Per-pharmacy number series (invoices, purchases, ...). Replaces global sequences.
model TenantCounter {
  pharmacyId String
  key        String
  value      BigInt @default(0)

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, key])
}

// Invite and password reset links. Only the SHA-256 of the token is stored.
model AuthToken {
  id             String       @id @default(uuid())
  realm          Realm
  subjectId      String
  pharmacyId     String?
  purpose        TokenPurpose
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdByRealm Realm
  createdById    String
  createdAt      DateTime     @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([subjectId, purpose])
}

// The Developer working inside a pharmacy. Every audit row written meanwhile references it.
model SupportSession {
  id             String    @id @default(uuid())
  platformUserId String
  pharmacyId     String
  reason         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId, startedAt])
}

// Per-pharmacy feature switches set by the Developer. Defaults live in code.
model FeatureFlag {
  pharmacyId String
  key        String
  enabled    Boolean
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, key])
}

// A file kept in the database (docs/plan/02-architecture.md, section 7.7): logos now, bill photos and
// receipts later. Stored in PostgreSQL so desktop backups, restores and row-level security cover files
// exactly as they cover the data that refers to them.
model StoredFile {
  id           String   @id @default(uuid())
  pharmacyId   String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  purpose      String // LOGO, LOGO_ICON, BILL, STOCK_LIST, IMPORT
  mime         String
  size         Int
  sha256       String
  width        Int?
  height       Int?
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  pharmacy   Pharmacy   @relation("PharmacyFiles", fields: [pharmacyId], references: [id])
  logoOf     Pharmacy[] @relation("PharmacyLogo")
  logoIconOf Pharmacy[] @relation("PharmacyLogoIcon")

  @@index([pharmacyId, sha256])
}

// Something a pharmacy's staff should see or act on (data model, section 5). Each one goes to people
// holding audiencePermission; dedupeKey keeps a repeated condition to one open notification.
model Notification {
  id                 String    @id @default(uuid())
  pharmacyId         String    @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  type               String // RESET_REQUEST, EXPIRY_30, EXPIRY_7, EXPIRED, LOW_STOCK, INTAKE_READY, ...
  severity           String    @default("INFO") // INFO, WARNING, CRITICAL
  title              String
  body               String    @default("")
  link               String?
  audiencePermission String
  dedupeKey          String
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  pharmacy Pharmacy           @relation(fields: [pharmacyId], references: [id])
  reads    NotificationRead[]

  @@unique([pharmacyId, dedupeKey])
  @@index([pharmacyId, createdAt])
}

model NotificationRead {
  notificationId String
  userId         String
  pharmacyId     String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([pharmacyId])
}

// A stock entry draft (data model, section 4.5): typed in, read from photos or imported from a file, then
// reviewed and posted as a supplier purchase or as opening stock.
model StockIntake {
  id              String       @id @default(uuid())
  pharmacyId      String       @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  number          String // SE-YYYYMMDD-00001
  kind            IntakeKind
  source          IntakeSource
  status          IntakeStatus @default(DRAFT)
  supplierId      String?
  supplierInvoice String?
  billDate        DateTime?    @db.Date
  billTotal       Decimal?     @db.Decimal(12, 2)
  billDiscount    Decimal      @default(0) @db.Decimal(12, 2)
  paid            Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod   String?
  note            String?
  purchaseOrderId String? // received against this order
  provider        String? // OCR adapter used
  rawResult       Json? // normalised provider output, kept for re-parsing and accuracy checks
  header          Json? // header fields read by OCR, with confidence
  error           String?
  attempts        Int          @default(0)
  postedAt        DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id])
  supplier Supplier?         @relation(fields: [supplierId], references: [id])
  pages    StockIntakePage[]
  lines    StockIntakeLine[]
  purchase Purchase?
  order    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])

  @@unique([pharmacyId, number])
  @@index([pharmacyId, status, createdAt])
}

model StockIntakePage {
  intakeId   String
  pageNo     Int
  fileId     String
  pharmacyId String @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))

  intake   StockIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy    @relation(fields: [pharmacyId], references: [id])

  @@id([intakeId, pageNo])
  @@index([pharmacyId])
}

model StockIntakeLine {
  id              String    @id @default(uuid())
  pharmacyId      String    @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  intakeId        String
  lineNo          Int
  rawText         String? // the OCR text of the row; null for typed lines
  name            String?
  medicineId      String?
  batchNumber     String?
  expiryDate      DateTime? @db.Date
  quantity        Int?
  bonusQty        Int?
  rate            Decimal?  @db.Decimal(12, 2)
  discountPercent Decimal?  @db.Decimal(5, 2)
  taxAmount       Decimal?  @db.Decimal(12, 2)
  amount          Decimal?  @db.Decimal(12, 2)
  salePrice       Decimal?  @db.Decimal(12, 2)
  matchMethod     String? // BARCODE, SUPPLIER_CODE, ALIAS, TRIGRAM, MANUAL
  confidence      Float? // 0..1, the lowest of the field confidences
  boxes           Json? // page number and box of the row on the photo
  ignored         Boolean   @default(false)

  intake   StockIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  medicine Medicine?   @relation(fields: [medicineId], references: [id])
  pharmacy Pharmacy    @relation(fields: [pharmacyId], references: [id])

  @@unique([intakeId, lineNo])
  @@index([pharmacyId])
}

// Text a supplier prints for a medicine, learned from every confirmed review. supplierId "" means the
// alias is for the whole pharmacy (stock lists have no supplier).
model SupplierItemAlias {
  id         String   @id @default(uuid())
  pharmacyId String   @default(dbgenerated("current_setting('app.pharmacy_id'::text, true)"))
  supplierId String   @default("")
  text       String // lower case, single spaces, no punctuation
  medicineId String
  hits       Int      @default(1)
  updatedAt  DateTime @updatedAt

  medicine Medicine @relation(fields: [medicineId], references: [id])
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@unique([pharmacyId, supplierId, text])
}
